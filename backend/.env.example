PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=kiosco_db
DB_USER=root
DB_PASSWORD=

JWT_SECRET=cambiar_este_valor_por_una_clave_segura
JWT_EXPIRES_IN=8h

# --- Envío de correos (recuperación de contraseña y pedidos al proveedor) ---
# Opción A (recomendada en Render): API de Brevo, gratis hasta 300 mails/día.
#   brevo.com > SMTP & API > API Keys. El remitente de SMTP_FROM tiene que
#   estar verificado en Brevo (Senders & IP > Senders).
BREVO_API_KEY=
# Opción B: SMTP (Gmail). Anda en la PC; el plan gratis de Render bloquea
# los puertos de correo, por eso allá conviene la opción A.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y en SMTP_PASS una
# "contraseña de aplicación" (no la clave normal de la cuenta).
# Si SMTP_HOST queda vacío, el código se muestra en la consola del backend
# (sirve solo para probar en desarrollo).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KiosquitoYa <tu_cuenta@gmail.com>"
